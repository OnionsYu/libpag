{
  "id": "org.libpag.photoshop.exporter",
  "name": "PAGX 导出",
  "version": "0.2.0",
  "manifestVersion": 6,
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "27.4.0", "data": { "apiVersion": 2 } },
  "entrypoints": [
    {
      "type": "panel", "id": "pagxExporter", "label": { "default": "PAGX 导出" },
      "minimumSize": { "width": 280, "height": 300 },
      "preferredDockedSize": { "width": 320, "height": 440 },
      "preferredFloatingSize": { "width": 340, "height": 440 }
    }
  ],
  "addon": { "name": "pagx-photoshop.uxpaddon" },
  "requiredPermissions": { "enableAddon": true, "localFileSystem": "request" }
}
